--- a/arch/sh/boards/mach-mb442/setup.c
+++ b/arch/sh/boards/mach-mb442/setup.c
@@ -207,6 +207,149 @@
 //	&iti_5800_nand_device,
 };
 
+/*
+ * NAND jak w jadrze Graterlii (odczytane z binarki): gen_nand na banku EMI 1,
+ * ALE = A16, CLE = A17, nCE = PIO 3.6, R/B = PIO 4.5, ECC programowe. Odczyt
+ * przez bank 1 (0x00400000), zapis i komendy przez bank 2 (0x00800000): A22 to
+ * nW, A23 to nR - stad IO_ADDR_W = io_base + 0x400000 w plat_nand.c.
+ */
+#define ITI_5800_NAND_BANK    1
+#define ITI_5800_NAND_ALE     (1 << 16)
+#define ITI_5800_NAND_CLE     (1 << 17)
+#define ITI_5800_NAND_NCE     stm_gpio(3, 6)
+#define ITI_5800_NAND_RBN     stm_gpio(4, 5)
+
+static void iti_5800_nand_cmd_ctrl(struct mtd_info *mtd, int cmd, unsigned int ctrl)
+{
+	struct nand_chip *this = mtd->priv;
+	unsigned long addr = (unsigned long)this->IO_ADDR_W;
+
+	if (ctrl & NAND_CTRL_CHANGE) {
+		if (ctrl & NAND_CLE)
+			addr |= ITI_5800_NAND_CLE;
+		else
+			addr &= ~ITI_5800_NAND_CLE;
+		if (ctrl & NAND_ALE)
+			addr |= ITI_5800_NAND_ALE;
+		else
+			addr &= ~ITI_5800_NAND_ALE;
+		this->IO_ADDR_W = (void __iomem *)addr;
+	}
+	if (ctrl & NAND_NCE)
+		gpio_set_value(ITI_5800_NAND_NCE, 0);
+	if (cmd != NAND_CMD_NONE)
+		writeb(cmd, this->IO_ADDR_W);
+}
+
+static int iti_5800_nand_dev_ready(struct mtd_info *mtd)
+{
+	return gpio_get_value(ITI_5800_NAND_RBN);
+}
+
+static void iti_5800_nand_read_buf(struct mtd_info *mtd, uint8_t *buf, int len)
+{
+	struct nand_chip *this = mtd->priv;
+
+	while (((unsigned long)buf & 3) && len > 0) {
+		*buf++ = readb(this->IO_ADDR_R);
+		len--;
+	}
+	readsl(this->IO_ADDR_R, buf, len / 4);
+	buf += len & ~3;
+	len &= 3;
+	while (len-- > 0)
+		*buf++ = readb(this->IO_ADDR_R);
+}
+
+static void iti_5800_nand_write_buf(struct mtd_info *mtd, const uint8_t *buf, int len)
+{
+	struct nand_chip *this = mtd->priv;
+
+	while (((unsigned long)buf & 3) && len > 0) {
+		writeb(*buf++, this->IO_ADDR_W);
+		len--;
+	}
+	writesl(this->IO_ADDR_W, buf, len / 4);
+	buf += len & ~3;
+	len &= 3;
+	while (len-- > 0)
+		writeb(*buf++, this->IO_ADDR_W);
+}
+
+static const char *iti_5800_nand_probes[] = { "cmdlinepart", NULL };
+
+static struct platform_nand_data iti_5800_gen_nand_data =
+{
+	.chip =
+	{
+		.nr_chips         = 1,
+		.nr_partitions    = ARRAY_SIZE(iti_5800_nand_parts),
+		.partitions       = iti_5800_nand_parts,
+		.chip_delay       = 40,  // in us
+		.options          = NAND_NO_AUTOINCR,
+		.part_probe_types = iti_5800_nand_probes,
+	},
+	.ctrl =
+	{
+		.dev_ready = iti_5800_nand_dev_ready,
+		.cmd_ctrl  = iti_5800_nand_cmd_ctrl,
+		.write_buf = iti_5800_nand_write_buf,
+		.read_buf  = iti_5800_nand_read_buf,
+	},
+};
+
+static struct resource iti_5800_gen_nand_res =
+{
+	.flags = IORESOURCE_MEM,
+};
+
+static struct platform_device iti_5800_gen_nand_device =
+{
+	.name              = "gen_nand",
+	.id                = ITI_5800_NAND_BANK,
+	.num_resources     = 1,
+	.resource          = &iti_5800_gen_nand_res,
+	.dev.platform_data = &iti_5800_gen_nand_data,
+};
+
+static struct emi_timing_data iti_5800_nand_timing =
+{
+	.rd_cycle_time  = 40,  // times in ns
+	.rd_oee_start   = 0,
+	.rd_oee_end     = 10,
+	.rd_latchpoint  = 10,
+	.busreleasetime = 0,
+	.wr_cycle_time  = 40,
+	.wr_oee_start   = 0,
+	.wr_oee_end     = 10,
+};
+
+static void __init iti_5800_gen_nand_init(void)
+{
+	/* slowa EMI banku 1 i 2 odczytane z rejestrow dzialajacej Graterlii */
+	unsigned long bank1[4] = { 0x00300619, 0x8a230000, 0x8a130000, 0 };
+	unsigned long bank2[4] = { 0x00300619, 0x8a230000, 0x8a130000, 0 };
+
+	if (gpio_request(ITI_5800_NAND_NCE, "nand_CE") != 0 ||
+	    gpio_request(ITI_5800_NAND_RBN, "nand_RBn") != 0) {
+		printk(KERN_ERR "iti_5800: brak GPIO dla NAND\n");
+		return;
+	}
+	gpio_direction_output(ITI_5800_NAND_NCE, 0);
+	gpio_direction_input(ITI_5800_NAND_RBN);
+
+	iti_5800_gen_nand_res.start = emi_bank_base(ITI_5800_NAND_BANK);
+	iti_5800_gen_nand_res.end = emi_bank_base(ITI_5800_NAND_BANK + 1) - 1;
+
+	emi_config_nand(ITI_5800_NAND_BANK, &iti_5800_nand_timing);
+	emi_bank_configure(1, bank1);
+	emi_bank_configure(2, bank2);
+	emi_config_pcmode(1, 0);
+	emi_config_pcmode(2, 0);
+
+	platform_device_register(&iti_5800_gen_nand_device);
+}
+
 static int __init iti_5800_device_init(void)
 {
 	stx7100_configure_sata();
@@ -226,7 +369,7 @@
 			.tx_od_enabled = 0, });
 
 // comment next line if you want NAND configuration through a device
-	stx7100_configure_nand(&iti_5800_nand_config);
+	iti_5800_gen_nand_init();
 
 	return platform_add_devices(iti_5800_devices, ARRAY_SIZE(iti_5800_devices));
 }
